# Déjalas vacías para desarrollo local: la app guarda las invitaciones en
# archivos JSON dentro de data/invitations/ (ver lib/store.local.js).
#
# Para producción (por ejemplo, un deploy en Vercel), crea un proyecto en
# supabase.com, corre supabase/schema.sql en su SQL editor, y llena estas
# dos variables con los valores de Project Settings → API. En cuanto ambas
# existen, lib/store.js cambia automáticamente a Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
